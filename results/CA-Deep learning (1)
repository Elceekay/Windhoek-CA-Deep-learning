n","    results[\"Urban_2020\"] = round(u20_mean_dist, 2)\n","    print(f\"   📏 Urban 2020: {u20_mean_dist:.2f} km from CBD\")\n","    return results\n","\n","def fig6_simulations_fixed(S, models=(\"CA-CNN\", \"CA-U-Net\", \"CA-LSTM-CNN\"),\n","                           years=(2030, 2040, 2050),\n","                           scenario_dir=\"revision_runs/scenarios2020\",\n","                           scenario=\"central trend scenario\"):\n","    crop, ext = mf._crop(S)\n","    u20 = (S.P[2020] == 1) & S.mask  # FIXED: Starts from 2020\n","\n","    fig, axes = plt.subplots(len(models), 3, figsize=(mf.W_MM / 25.4, mf.W_MM / 25.4 * 0.34 * len(models) + 0.35),\n","                             squeeze=False)\n","    cols = [\"#f2f2f2\", \"#7f7f7f\", \"#b30000\"]\n","\n","    for i, m in enumerate(models):\n","        for j, y in enumerate(years):\n","            ax = axes[i, j]\n","            sim_file = f\"{scenario_dir}/Proj_{m}_central_{y}.tif\"\n","            if os.path.exists(sim_file):\n","                sim = (ra.read(sim_file)[0] == 1) & S.mask\n","                img = np.full(S.mask.shape, np.nan)\n","                img[S.mask] = 0\n","                img[u20] = 1\n","                img[sim & ~u20] = 2\n","                ax.imshow(img[crop], cmap=ListedColormap(cols), vmin=-0.5, vmax=2.5,\n","                         extent=ext, interpolation=\"nearest\")\n","            else:\n","                ax.text(0.5, 0.5, f\"File missing:\\n{m} {y}\", ha='center', va='center', transform=ax.transAxes)\n","\n","            mf._style_axes(ax, ext, left=(j == 0), bottom=(i == len(models) - 1))\n","            ax.set_title(f\"({chr(97 + 3*i + j)}) {m}, {y}\", fontsize=7, loc=\"left\", pad=2)\n","\n","            if i == len(models) - 1 and j == 2:\n","                mf._scalebar(axes[-1, -1], ext)\n","\n","    fig.legend(handles=[Patch(color=cols[1], label=\"Urban 2020\"),\n","                       Patch(color=cols[2], label=f\"Simulated new urban land ({scenario})\")],\n","              loc=\"lower center\", ncol=2, frameon=False, fontsize=7, bbox_to_anchor=(0.5, -0.02))\n","    fig.subplots_adjust(wspace=0.05, hspace=0.15, bottom=0.1)\n","\n","    output_path = mf._out(S, \"Figure6_simulations_from2020_FIXED\")\n","    # FIXED: Removed the accidental space in \"tight\"\n","    fig.savefig(output_path + \".png\", dpi=600, bbox_inches=\"tight\")\n","    fig.savefig(output_path + \".pdf\", bbox_inches=\"tight\")\n","    plt.close(fig)\n","    print(f\"✅ Figure 6 saved at 600 dpi: {output_path}.png\")\n","    return output_path\n","\n","def fig7_agreement_fixed(S, models=(\"CA-CNN\", \"CA-U-Net\", \"CA-LSTM-CNN\"),\n","                         scenario_dir=\"revision_runs/scenarios2020\"):\n","    crop, ext = mf._crop(S)\n","    u20 = (S.P[2020] == 1) & S.mask\n","\n","    gain = []\n","    valid_models = []\n","    for m in models:\n","        sim_file = f\"{scenario_dir}/Proj_{m}_central_2050.tif\"\n","        if os.path.exists(sim_file):\n","            g = ((ra.read(sim_file)[0] == 1) & S.mask & ~u20)\n","            gain.append(g)\n","            valid_models.append(m)\n","        else:\n","            print(f\"   ⚠️ Figure 7: Scenario file for {m} not found at {sim_file}\")\n","\n","    n_models = len(gain)\n","    cols = [\"#f2f2f2\", \"#7f7f7f\", \"#fdd49e\", \"#fc8d59\", \"#b30000\", \"#67000d\"]\n","    labs = [\"Non-urban\", \"Urban 2020\"] + [f\"New urban: {k} model{'s' if k > 1 else ''}\" for k in range(1, n_models + 1)]\n","\n","    fig, (a, b) = plt.subplots(1, 2, figsize=(mf.W_MM / 25.4, mf.W_MM / 25.4 * 0.47),\n","                               gridspec_kw={\"width_ratios\": [1.15, 1]})\n","\n","    img = np.full(S.mask.shape, np.nan)\n","    img[S.mask] = 0\n","    img[u20] = 1\n","\n","    if n_models >= 2:\n","        cons = np.sum(gain, 0)\n","        all_agree = (cons == n_models).sum() * ra.PX_KM2\n","        print(f\"\\n✅ All {n_models} models agree on: {all_agree:.2f} km²\")\n","\n","        for k in ra