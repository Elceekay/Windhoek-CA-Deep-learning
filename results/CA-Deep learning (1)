,"Data folder: /content/drive/MyDrive/GEE_Windhoek/\n"]}]},{"cell_type":"code","source":["# Cell 4  Load the analysis code (from Drive) and the eight final maps\n","import sys, importlib, numpy as np, pandas as pd\n","sys.path.insert(0, D)\n","import revision_analyses as ra, make_figures as mf\n","importlib.reload(ra); importlib.reload(mf)\n","print(\"code loaded from:\", ra.__file__)\n","OUT = D + \"revision_runs/\"; os.makedirs(OUT, exist_ok=True)\n","RES = OUT + \"RESULTS/\"; os.makedirs(RES, exist_ok=True)\n","S = ra.Study(D=D)          # should print: Modelling mask: 533.63 km²\n","YEARS = [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Baa7AY4mHIBA","executionInfo":{"status":"ok","timestamp":1793653384655,"user_tz":-120,"elapsed":25440,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"8c04a917-c535-4c2f-e9f8-1d0b39b64500"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["code loaded from: /content/drive/MyDrive/GEE_Windhoek/revision_analyses.py\n","Modelling mask: 533.63 km²\n"]}]},{"cell_type":"code","source":["# Cell R0  Round-2 analyses: setup (run after Cell 1 and Cell 4 in every session)\n","import os, glob, numpy as np, pandas as pd, rasterio\n","R2 = OUT + \"round2/\"; os.makedirs(R2, exist_ok=True)\n","R2LOG = R2 + \"round2_runs.csv\"\n","HC = dict(train=[(1990, 1995), (1995, 2000), (2000, 2005), (2005, 2010)], tune=[(2010, 2015)], test=(2015, 2020))\n","EQ2 = dict(train=[(2000, 2005), (2005, 2010)], tune=[(2010, 2015)], test=(2015, 2020))   # same two transitions as the CA-LSTM-CNN\n","P2 = {y: f\"Windhoek_LULC_{y}_automated.tif\" for y in range(1990, 2025, 5)}               # automated maps 1990-2020\n","missing = [f for f in P2.values() if not os.path.exists(D + f)]\n","print(\"automated (P2) maps missing:\", missing if missing else \"none ✅\")\n","try:\n","    import tensorflow as tf\n","    GPU = bool(tf.config.list_physical_devices(\"GPU\"))\n","except Exception:\n","    GPU = False\n","RUN_UNET = GPU          # CA-U-Net jobs run only on a GPU runtime (on CPU each takes 4-6 h); set to True to force\n","print(\"GPU available:\", GPU, \"| CA-U-Net jobs will\", \"run\" if RUN_UNET else \"be skipped in this session\")\n","LOGC = [\"experiment\", \"model\", \"seed\", \"FoM\", \"hits_km2\", \"misses_km2\", \"false_alarms_km2\", \"best_epoch\", \"epochs_run\", \"s_per_epoch\"]\n","\n","def _tag(exp, model, seed):\n","    return f\"{exp}__{model}__s{seed}\"\n","\n","def is_done(exp, model, seed):\n","    return os.path.exists(R2 + f\"Pred_{_tag(exp, model, seed)}.tif\")\n","\n","def _save(study, pm, sc, exp, model, seed):\n","    p = study.profile.copy(); p.update(dtype=\"uint8\", nodata=0, count=1, compress=\"lzw\")\n","    with rasterio.open(R2 + f\"Pred_{_tag(exp, model, seed)}.tif\", \"w\", **p) as o:\n","        o.write(np.where(study.mask, pm.astype(\"uint8\") + 1, 0).astype(\"uint8\"), 1)\n","    row = {**sc, \"experiment\": exp, \"model\": model, \"seed\": seed}\n","    pd.DataFrame([row]).reindex(columns=LOGC).to_csv(R2LOG, mode=\"a\", header=not os.path.exists(R2LOG), index=False)\n","    print(f\"{exp:20s} {model:14s} seed {seed}: FoM {sc['FoM']}\")\n","\n","def run_job(study, exp, model, seed, cfg):\n","    if is_done(exp, model, seed):\n","        print(\"already done:\", exp, model, seed); return\n","    if model == \"CA-U-Net\" and not RUN_UNET:\n","        print(\"skipped for now (needs GPU):\", exp, model, seed); return\n","    if model == \"Logistic-CA\":\n","        sc, pm, _ = ra.run_logistic(study, **{k: v for k, v in cfg.items() if k in (\"train\", \"tune\", \"test\", \"buffer\")})\n","    elif model == \"Neighbourhood\":\n","        sc, pm = ra.run_neighbourhood(study, test=cfg[\"test\"])\n","    else:\n","        sc, pm, _ = ra.run_network(study, model, seed=seed, **cfg)\n","    _save(study, pm, sc, exp, model, seed)\n","\n","print(\"round-2 setup ready ✅\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JMY0B85BHff8","executionInfo":{"status":"ok","timestamp":1793653395997,"user_tz":-120,"elapsed":4507,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"1593fcbc-5b4c-49e6-b9cc-ff05c747f492"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["automated (P2) maps missing: none ✅\n","GPU available: False | CA-U-Net jobs will be skipped in this session\n","round-2 setup ready ✅\n"]}]},{"cell_type":"code","source":["# Cell R1  Comment 1: main hindcast repeated on the AUTOMATED (P2) maps, i.e. with no manual editing at all\n","S2 = ra.Study(D=D, files=P2)                     # prints the P2 modelling mask\n","u15, u20 = (S2.P[2015] == 1) & S2.mask, (S2.P[2020] == 1) & S2.mask\n","print(\"observed 2015–2020 urban gain on the P2 maps:\", round(float((~u15 & u20).sum() * ra.PX_KM2), 2), \"km² (final maps: 15.54 km²)\")\n","for model in (\"Logistic-CA\", \"Neighbourhood\", \"CA-CNN\", \"CA-LSTM-CNN\", \"CA-U-Net\"):\n","    run_job(S2, \"P2_maps\", model, 42, HC)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EIHB2VFDHorZ","executionInfo":{"status":"ok","timestamp":1793623937467,"user_tz":-120,"elapsed":3294142,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"8a3ba30a-a3a8-4b67-fc89-14d38e014d25"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Modelling mask: 531.44 km²\n","observed 2015–2020 urban gain on the P2 maps: 23.81 km² (final maps: 15.54 km²)\n","P2_maps              Logistic-CA    seed 42: FoM 0.273\n","P2_maps              Neighbourhood  seed 42: FoM 0.233\n","P2_maps              CA-CNN         seed 42: FoM 0.233\n","P2_maps              CA-LSTM-CNN    seed 42: FoM 0.275\n","skipped for now (needs GPU): P2_maps CA-U-Net 42\n"]}]},{"cell_type":"code","source":["# Cell R2  Comment 3: main hindcast with a four-cell buffer between training and tuning blocks (final maps)\n","for model in (\"Logistic-CA\", \"CA-CNN\", \"CA-LSTM-CNN\", \"CA-U-Net\"):\n","    run_job(S, \"buffer_4cells\", model, 42, {**HC, \"buffer\": True})"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fwWSzuxGH1Hy","executionInfo":{"status":"ok","timestamp":1793655721869,"user_tz":-120,"elapsed":2259968,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"2201ac0b-d847-46a6-ff7f-97597a1fd72c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["buffer_4cells        Logistic-CA    seed 42: FoM 0.207\n","buffer_4cells        CA-CNN         seed 42: FoM 0.196\n","buffer_4cells        CA-LSTM-CNN    seed 42: FoM 0.198\n","skipped for now (needs GPU): buffer_4cells CA-U-Net 42\n"]}]},{"cell_type":"code","source":["# Cell R3  Comment 4: CA-CNN and CA-U-Net trained on the same two transitions as the CA-LSTM-CNN (2000–2010)\n","for model, seeds in ((\"Logistic-CA\", (42,)), (\"CA-CNN\", (42, 1, 2, 3)), (\"CA-U-Net\", (42,))):\n","    for seed in seeds:\n","        run_job(S, \"equal_2transitions\", model, seed, EQ2)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4eaGhpzxFCzO","executionInfo":{"status":"ok","timestamp":1793663930655,"user_tz":-120,"elapsed":7862624,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"d30389fe-c9c8-402f-c894-fffc8ab4e496"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["equal_2transitions   Logistic-CA    seed 42: FoM 0.208\n","equal_2transitions   CA-CNN         seed 42: FoM 0.2\n","equal_2transitions   CA-CNN         seed 1: FoM 0.188\n","equal_2transitions   CA-CNN         seed 2: FoM 0.2\n","equal_2transitions   CA-CNN         seed 3: FoM 0.195\n","skipped for now (needs GPU): equal_2transitions CA-U-Net 42\n"]}]},{"cell_type":"code","source":["# Cell R4  Summary of Cells R1-R3: FoM with 95% block-bootstrap CI (4 km blocks) and difference from logistic-regression CA\n","def summarise(study, exp):\n","    files = sorted(glob.glob(R2 + f\"Pred_{exp}__*.tif\"))\n","    if not files:\n","        print(f\"\\n{exp}: no runs yet\"); return pd.DataFrame()\n","    blk4, _ = study.blocks(133)\n","    u0 = (study.P[2015] == 1) & study.mask; u1 = (study.P[2020] == 1) & study.mask\n","    og = (~u0 & u1)[study.mask]; ub, bi = np.unique(blk4[study.mask], return_inverse=True)\n","    draw = np.random.default_rng(0).integers(0, len(ub), (2000, len(ub)))\n","    def counts(pm):\n","        pg = (~u0 & pm)[study.mask]\n","        return np.stack([np.bincount(bi, (og & pg).astype(float), len(ub)), np.bincount(bi, (og & ~pg).astype(float), len(ub)),\n","                         np.bincount(bi, (~og & pg).astype(float), len(ub))], 1)\n","    def boot(c):\n","        s = c[draw].sum(1); return s[:, 0] / s.sum(1)\n","    C = {os.path.basename(f)[len(f\"Pred_{exp}__\"):-4]: counts(ra.read(f)[0] == 2) for f in files}\n","    ref = [k for k in C if k.startswith(\"Logistic-CA\")]\n","    rows = []\n","    for k, c in C.items():\n","        f = c[:, 0].sum() / c.sum(); b = boot(c)\n","        r = {\"experiment\": exp, \"run\": k, \"FoM\": round(f, 3),\n","             \"FoM_CI95\": f\"{np.nanpercentile(b, 2.5):.3f}–{np.nanpercentile(b, 97.5):.3f}\", \"hits_km2\": round(c[:, 0].sum() * ra.PX_KM2, 2)}\n","        if ref:\n","            cl = C[ref[0]]; d = b - boot(cl); lo, hi = np.nanpercentile(d, [2.5, 97.5])\n","            r.update(minus_logistic=round(f - cl[:, 0].sum() / cl.sum(), 3), diff_CI95=f\"{lo:+.3f} to {hi:+.3f}\",\n","                     significant=bool(lo > 0 or hi < 0))\n","        rows.append(r)\n","    print(f\"\\n{exp}: observed 2015–2020 urban gain {og.sum() * ra.PX_KM2:.2f} km²\")\n","    return pd.DataFrame(rows)\n","\n","if \"S2\" not in globals():\n","    S2 = ra.Study(D=D, files=P2)\n","tab = pd.concat([summarise(S2, \"P2_maps\"), summarise(S, \"buffer_4cells\"), summarise(S, \"equal_2transitions\")], ignore_index=True)\n","tab.to_csv(RES + \"TableS12_round2_hindcast_sensitivity.csv\", index=False)\n","print(tab.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NNwl30-10Ih7","executionInfo":{"status":"ok","timestamp":1793665849304,"user_tz":-120,"elapsed":8194,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"fe05f390-1e3b-434e-fc03-3d94223adb72"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Modelling mask: 531.44 km²\n","\n","P2_maps: observed 2015–2020 urban gain 23.81 km²\n","\n","buffer_4cells: observed 2015–2020 urban gain 15.54 km²\n","\n","equal_2transitions: observed 2015–2020 urban gain 15.54 km²\n","        experiment                run   FoM    FoM_CI95  hits_km2  minus_logistic        diff_CI95  significant\n","           P2_maps        CA-CNN__s42 0.233 0.160–0.288      9.01          -0.039 -0.069 to -0.016         True\n","           P2_maps   CA-LSTM-CNN__s42 0.275 0.213–0.324     10.27           0.002 -0.025 to +0.035        False\n","           P2_maps   Logistic-CA__s42 0.273 0.204–0.321     10.20           0.000 +0.000 to +0.000        False\n","           P2_maps Neighbourhood__s42 0.233 0.176–0.272      8.99          -0.040 -0.071 to -0.009         True\n","     buffer_4cells        CA-CNN__s42 0.196 0.142–0.239      5.09          -0.011 -0.020 to -0.001         True\n","     buffer_4cells   CA-LSTM-CNN__s42 0.198 0.147–0.239      5.13          -0.009 -0.021 to +0.003        False\n","     buffer_4cells   Logistic-CA__s42 0.207 0.151–0.249      5.32           0.000 +0.000 to +0.000        False\n","equal_2transitions         CA-CNN__s1 0.188 0.132–0.233      4.91          -0.020 -0.043 to -0.001         True\n","equal_2transitions         CA-CNN__s2 0.200 0.140–0.245      5.17          -0.008 -0.022 to +0.005        False\n","equal_2transitions         CA-CNN__s3 0.195 0.138–0.238      5.06          -0.014 -0.026 to -0.004         True\n","equal_2transitions        CA-CNN__s42 0.200 0.141–0.246      5.19          -0.008 -0.020 to +0.004        False\n","equal_2transitions   Logistic-CA__s42 0.208 0.153–0.249      5.35           0.000 +0.000 to +0.000        False\n"]}]},{"cell_type":"code","source":["# Cell R5  Comment 1: independent 2025 sample with and without the 13 uncertain points\n","import geopandas as gpd\n","from rasterio.transform import rowcol\n","found = sorted([f for f in glob.glob(\"/content/drive/MyDrive/**/Independent2025_labels*\", recursive=True)\n","                if f.lower().endswith((\".xlsx\", \".csv\"))], key=os.path.getmtime, reverse=True)\n","lab = None\n","for f in found:\n","    t = pd.read_excel(f) if f.lower().endswith(\".xlsx\") else pd.read_csv(f)\n","    if \"ref\" in t.columns and t[\"ref\"].notna().sum() >= 290:\n","        lab = t; print(\"labels file:\", f); break\n","d = lab[[\"id\", \"lat\", \"lon\", \"ref\", \"unsure\"]].copy(); d[\"ref\"] = d[\"ref\"].astype(int)\n","with rasterio.open(D + ra.PAPER[2025]) as src:\n","    L25 = src.read(1)\n","    xy = gpd.GeoSeries(gpd.points_from_xy(d[\"lon\"], d[\"lat\"]), crs=4326).to_crs(src.crs)\n","    r, c = rowcol(src.transform, xy.x.values, xy.y.values)\n","d[\"map\"] = L25[np.asarray(r), np.asarray(c)].astype(int)\n","A25 = ra.class_areas(L25)\n","keep = d[\"unsure\"].astype(str).str.strip().str.upper() != \"Y\"\n","out = []\n","for name, dd in ((\"all 300 points\", d), (\"without the uncertain points\", d[keep])):\n","    cm = np.zeros((4, 4), int)\n","    for a, b in zip(dd[\"map\"], dd[\"ref\"]):\n","        cm[a - 1, b - 1] += 1\n","    res, oa = ra.olofsson_estimator(cm, A25)\n","    out.append({\"sample\": name, \"n\": len(dd), \"OA_%\": oa[\"OA_%\"], \"OA_ci95\": oa[\"OA_ci95\"],\n","                \"urban_area_km2\": res.loc[\"Urban\", \"area_km2\"], \"urban_area_ci95\": res.loc[\"Urban\", \"area_ci95_km2\"],\n","                \"urban_UA_%\": res.loc[\"Urban\", \"UA_%\"], \"urban_PA_%\": res.loc[\"Urban\", \"PA_%\"]})\n","o = pd.DataFrame(out); o.to_csv(RES + \"TableS13_independent2025_uncertain_points.csv\", index=False)\n","print(o.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TnTtzvKz0XBz","executionInfo":{"status":"ok","timestamp":1793665906439,"user_tz":-120,"elapsed":6133,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"655b0742-ef46-4662-bbe1-62d375e9914b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["labels file: /content/drive/MyDrive/Independent2025_labels.xlsx\n","                      sample   n  OA_%  OA_ci95  urban_area_km2  urban_area_ci95  urban_UA_%  urban_PA_%\n","              all 300 points 300 71.20     6.12           96.43            16.51       70.00       85.23\n","without the uncertain points 287 73.58     5.93           98.24            17.13       70.71       84.50\n"]}]},{"cell_type":"code","source":["# Cell R6  Comments 2 and 5: urban area 1990–2020 from the raw (P1), automated (P2) and final (P3) maps, trend slopes, implied 2050 demand\n","if \"S2\" not in globals():\n","    S2 = ra.Study(D=D, files=P2)\n","Y = np.array([1990, 1995, 2000, 2005, 2010, 2015, 2020])\n","P1 = {y: ra.read(D + ra.RAW[y])[0] for y in Y}\n","common = S.mask & S2.mask & np.logical_and.reduce([np.isin(P1[y], [1, 2, 3, 4]) for y in Y])\n","print(f\"common mask (valid in every P1, P2 and P3 map): {common.sum() * ra.PX_KM2:.2f} km²\")\n","series = {\"P1 raw\": P1, \"P2 automated\": S2.P, \"P3 final\": S.P}\n","tab = {}\n","for name, maps in series.items():\n","    A_ = np.array([((maps[y] == 1) & common).sum() * ra.PX_KM2 for y in Y])\n","    b, a0 = np.polyfit(Y, A_, 1); r2 = 1 - ((A_ - (a0 + b * Y)) ** 2).sum() / ((A_ - A_.mean()) ** 2).sum()\n","    tab[name] = list(A_.round(2)) + [round(b, 3), round(r2, 3), round(A_[-1] + 30 * b, 2)]\n","traj = pd.DataFrame(tab, index=[str(y) for y in Y] + [\"slope_km2_per_yr\", \"R2\", \"central_2050_km2\"]).T\n","traj.to_csv(RES + \"TableS14_trajectory_P1_P2_P3.csv\"); print(traj.to_string())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xQx6UKyx0a80","executionInfo":{"status":"ok","timestamp":1793665941534,"user_tz":-120,"elapsed":310,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"2013787a-fe55-4527-a956-413c4509668b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["common mask (valid in every P1, P2 and P3 map): 531.29 km²\n","               1990   1995   2000   2005    2010   2015   2020  slope_km2_per_yr     R2  central_2050_km2\n","P1 raw        31.54  44.79  53.55  73.26  107.60  69.72  91.55             2.028  0.681            152.40\n","P2 automated  45.08  41.63  50.81  66.84  106.99  70.82  89.89             1.778  0.628            143.24\n","P3 final      37.46  39.34  51.44  66.84   80.58  87.30  93.96             2.104  0.974            157.07\n"]}]},{"cell_type":"code","source":["# 0.1  Mount Drive, install rasterio, find your data folder\n","!pip install rasterio -q\n","from google.colab import drive\n","drive.mount('/content/drive')\n","import os, glob, sys\n","\n","D = \"/content/drive/MyDrive/GEE_Windhoek/\"          # your data folder (with the trailing /)\n","if not os.path.exists(D + \"Windhoek_LULC_2025_Final_FIXED.tif\"):\n","    hits = glob.glob(\"/content/drive/MyDrive/**/Windhoek_LULC_2025_Final_FIXED.tif\", recursive=True)\n","    if hits:\n","        D = os.path.dirname(hits[0]) + \"/\"\n","print(\"Data folder:\", D)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IMJ_hfKG0k8j","executionInfo":{"status":"ok","timestamp":1793667021763,"user_tz":-120,"elapsed":40320,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"224a6a72-5f4e-4bb8-c444-b1f02fcd4e87"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Data folder: /content/drive/MyDrive/GEE_Windhoek/\n"]}]},{"cell_type":"code","source":["# Cell 4  Load the analysis code (from Drive) and the eight final maps\n","import sys, importlib, numpy as np, pandas as pd\n","sys.path.insert(0, D)\n","import revision_analyses as ra, make_figures as mf\n","importlib.reload(ra); importlib.reload(mf)\n","print(\"code loaded from:\", ra.__file__)\n","OUT = D + \"revision_runs/\"; os.makedirs(OUT, exist_ok=True)\n","RES = OUT + \"RESULTS/\"; os.makedirs(RES, exist_ok=True)\n","S = ra.Study(D=D)          # should print: Modelling mask: 533.63 km²\n","YEARS = [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DcJqlB4h4pNu","executionInfo":{"status":"ok","timestamp":1793667064303,"user_tz":-120,"elapsed":24484,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"cf113bfe-e863-46c4-aadb-3bca44c0f757"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["code loaded from: /content/drive/MyDrive/GEE_Windhoek/revision_analyses.py\n","Modelling mask: 533.63 km²\n"]}]},{"cell_type":"code","source":["# Cell G1  Round 2 on GPU: the three CA-U-Net jobs (P2 maps, buffer, equal transitions) + updated summary\n","import os, glob, numpy as np, pandas as pd, rasterio, tensorflow as tf\n","print(\"GPU:\", tf.config.list_physical_devices(\"GPU\") or \"NONE - switch the runtime to GPU first (on CPU each run takes 4-6 h)\")\n","R2 = OUT + \"round2/\"; os.makedirs(R2, exist_ok=True); R2LOG = R2 + \"round2_runs.csv\"\n","HC = dict(train=[(1990, 1995), (1995, 2000), (2000, 2005), (2005, 2010)], tune=[(2010, 2015)], test=(2015, 2020))\n","EQ2 = dict(train=[(2000, 2005), (2005, 2010)], tune=[(2010, 2015)], test=(2015, 2020))\n","P2 = {y: f\"Windhoek_LULC_{y}_automated.tif\" for y in range(1990, 2025, 5)}\n","LOGC = [\"experiment\", \"model\", \"seed\", \"FoM\", \"hits_km2\", \"misses_km2\", \"false_alarms_km2\", \"best_epoch\", \"epochs_run\", \"s_per_epoch\"]\n","S2 = ra.Study(D=D, files=P2)\n","\n","def unet_job(study, exp, cfg):\n","    f = R2 + f\"Pred_{exp}__CA-U-Net__s42.tif\"\n","    if os.path.exists(f):\n","        print(\"already done:\", exp); return\n","    sc, pm, _ = ra.run_network(study, \"CA-U-Net\", seed=42, **cfg)\n","    p = study.profile.copy(); p.update(dtype=\"uint8\", nodata=0, count=1, compress=\"lzw\")\n","    with rasterio.open(f, \"w\", **p) as o:\n","        o.write(np.where(study.mask, pm.astype(\"uint8\") + 1, 0).astype(\"uint8\"), 1)\n","    pd.DataFrame([{**sc, \"experiment\": exp, \"model\": \"CA-U-Net\", \"seed\": 42}]).reindex(columns=LOGC).to_csv(\n","        R2LOG, mode=\"a\", header=not os.path.exists(R2LOG), index=False)\n","    print(f\"{exp:20s} CA-U-Net seed 42: FoM {sc['FoM']}\")\n","\n","unet_job(S2, \"P2_maps\", HC)\n","unet_job(S, \"buffer_4cells\", {**HC, \"buffer\": True})\n","unet_job(S, \"equal_2transitions\", EQ2)\n","\n","def summarise(study, exp):\n","    files = sorted(glob.glob(R2 + f\"Pred_{exp}__*.tif\"))\n","    blk4, _ = study.blocks(133)\n","    u0 = (study.P[2015] == 1) & study.mask; u1 = (study.P[2020] == 1) & study.mask\n","    og = (~u0 & u1)[study.mask]; ub, bi = np.unique(blk4[study.mask], return_inverse=True)\n","    draw = np.random.default_rng(0).integers(0, len(ub), (2000, len(ub)))\n","    def counts(pm):\n","        pg = (~u0 & pm)[study.mask]\n","        return np.stack([np.bincount(bi, (og & pg).astype(float), len(ub)), np.bincount(bi, (og & ~pg).astype(float), len(ub)),\n","                         np.bincount(bi, (~og & pg).astype(float), len(ub))], 1)\n","    def boot(c):\n","        s = c[draw].sum(1); return s[:, 0] / s.sum(1)\n","    C = {os.path.basename(f)[len(f\"Pred_{exp}__\"):-4]: counts(ra.read(f)[0] == 2) for f in files}\n","    cl = C[[k for k in C if k.startswith(\"Logistic-CA\")][0]]; bl = boot(cl); fl = cl[:, 0].sum() / cl.sum()\n","    rows = []\n","    for k, c in C.items():\n","        f = c[:, 0].sum() / c.sum(); b = boot(c); lo, hi = np.nanpercentile(b - bl, [2.5, 97.5])\n","        rows.append({\"experiment\": exp, \"run\": k, \"FoM\": round(f, 3),\n","                     \"FoM_CI95\": f\"{np.nanpercentile(b, 2.5):.3f}–{np.nanpercentile(b, 97.5):.3f}\",\n","                     \"hits_km2\": round(c[:, 0].sum() * ra.PX_KM2, 2), \"minus_logistic\": round(f - fl, 3),\n","                     \"diff_CI95\": f\"{lo:+.3f} to {hi:+.3f}\", \"significant\": bool(lo > 0 or hi < 0)})\n","    return pd.DataFrame(rows)\n","\n","tab = pd.concat([summarise(S2, \"P2_maps\"), summarise(S, \"buffer_4cells\"), summarise(S, \"equal_2transitions\")], ignore_index=True)\n","tab.to_csv(RES + \"TableS12_round2_hindcast_sensitivity.csv\", index=False)\n","print(tab.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_QiOv6U44x5L","executionInfo":{"status":"ok","timestamp":1793668069222,"user_tz":-120,"elapsed":797528,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"}},"outputId":"4424e6a9-bf95-49ac-99f1-bd6d52192fca"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["GPU: [PhysicalDevice(name='/physical_device:GPU:0', device_type='GPU')]\n","Modelling mask: 531.44 km²\n","P2_maps              CA-U-Net seed 42: FoM 0.257\n","buffer_4cells        CA-U-Net seed 42: FoM 0.204\n","equal_2transitions   CA-U-Net seed 42: FoM 0.195\n","        experiment                run   FoM    FoM_CI95  hits_km2  minus_logistic        diff_CI95  significant\n","           P2_maps        CA-CNN__s42 0.233 0.160–0.288      9.01          -0.039 -0.069 to -0.016         True\n","           P2_maps   CA-LSTM-CNN__s42 0.275 0.213–0.324     10.27           0.002 -0.025 to +0.035        False\n","           P2_maps      CA-U-Net__s42 0.257 0.184–0.311      9.72          -0.016 -0.038 to +0.002        False\n","           P2_maps   Logistic-CA__s42 0.273 0.204–0.321     10.20           0.000 +0.000 to +0.000        False\n","           P2_maps Neighbourhood__s4