rname = re.split(r\",|\\.\\s|\\(\", entry, 1)[0].strip()\n","    y = re.search(r\"\\((\\d{4})\", entry)\n","    m = re.search(r\"\\(\\d{4}[a-z]?(?:,[^)]*)?\\)\\.\\s*(.+?)(?:\\.\\s|\\?\\s)\", entry)\n","    return surname, int(y.group(1)) if y else None, m.group(1) if m else \"\"\n","\n","def fetch(url):\n","    req = urllib.request.Request(url, headers={\"User-Agent\": f\"doi-check/1.0 (mailto:{MAILTO or 'none'})\"})\n","    try:\n","        with urllib.request.urlopen(req, timeout=30) as r:\n","            return json.loads(r.read().decode())\n","    except urllib.error.HTTPError as e:\n","        return None if e.code == 404 else {\"_error\": f\"HTTP {e.code}\"}\n","    except Exception as e:\n","        return {\"_error\": str(e)[:60]}\n","\n","def lookup(doi):\n","    j = fetch(\"https://api.crossref.org/works/\" + urllib.parse.quote(doi, safe=\"\"))\n","    if j and \"message\" in j:\n","        m = j[\"message\"]; yrs = []\n","        for k in (\"issued\", \"published-print\", \"published-online\", \"published\"):\n","            dp = (m.get(k) or {}).get(\"date-parts\") or [[None]]\n","            if dp[0][0]: yrs.append(int(dp[0][0]))\n","        a = (m.get(\"author\") or [{}])[0]\n","        return \"Crossref\", (a.get(\"family\") or a.get(\"name\") or \"\"), yrs, ((m.get(\"title\") or [\"\"]) + [\"\"])[0], None\n","    j2 = fetch(\"https://api.datacite.org/dois/\" + urllib.parse.quote(doi, safe=\"\"))\n","    if j2 and \"data\" in j2:\n","        a = j2[\"data\"][\"attributes\"]; c = (a.get(\"creators\") or [{}])[0]\n","        return (\"DataCite\", c.get(\"familyName\") or c.get(\"name\") or \"\", [a.get(\"publicationYear\")] if a.get(\"publicationYear\") else [],\n","                ((a.get(\"titles\") or [{}])[0]).get(\"title\", \"\"), None)\n","    err = (j or {}).get(\"_error\") or (j2 or {}).get(\"_error\")\n","    return None, \"\", [], \"\", err\n","\n","rows = []\n","for entry in refs:\n","    doi = get_doi(entry); surname, year, title = parse(entry)\n","    if not doi:\n","        rows.append(dict(status=\"NO DOI\", entry=entry[:90])); continue\n","    src, fam, yrs, rtitle, err = lookup(doi); time.sleep(0.15)\n","    if src is None:\n","        rows.append(dict(status=\"ERROR\" if err else \"NOT FOUND\", doi=doi, entry=entry[:90], note=err or \"\")); continue\n","    a_ok = bool(norm(fam)) and (norm(fam)[-1] in norm(surname) or norm(surname)[-1:] == norm(fam)[-1:])\n","    y_ok = year is not None and any(abs(year - y) <= 1 for y in yrs)\n","    t_sim = SequenceMatcher(None, \" \".join(norm(title)), \" \".join(norm(rtitle))).ratio() if title and rtitle else 0\n","    t_ok = t_sim >= 0.6 or \" \".join(norm(rtitle)) in \" \".join(norm(entry))\n","    notes = [n for n, ok in ((\"author\", a_ok), (\"year\", y_ok), (\"title\", t_ok)) if not ok]\n","    rows.append(dict(status=\"OK\" if not notes else \"CHECK\", doi=doi, entry=entry[:90], registry=src,\n","                     registered_author=fam, registered_year=\"/\".join(map(str, sorted(set(yrs)))),\n","                     registered_title=rtitle[:90], title_similarity=round(t_sim, 2), note=\", \".join(notes)))\n","\n","rep = pd.DataFrame(rows)\n","out = os.path.join(os.path.dirname(DOCX) if DOCX.startswith(\"/content/drive\") else \"/content\", \"doi_check_report.csv\")\n","rep.to_csv(out, index=False)\n","print(f\"\\n{len(refs)} references: \" + \", \".join(f\"{k} {v}\" for k, v in rep[\"status\"].value_counts().items()))\n","print(\"report saved to\", out)\n","bad = rep[~rep[\"status\"].isin([\"OK\", \"NO DOI\"])]\n","pd.set_option(\"display.width\", 250); pd.set_option(\"display.max_colwidth\", 70)\n","print(\"\\nOpen these by hand:\" if len(bad) else \"\\nAll DOIs match their references ✅\")\n","if len(bad):\n","    print(bad[[\"status\", \"doi\", \"entry\", \"registered_author\", \"registered_year\", \"note\"]].to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PciAkm6oDrs9","executionInfo":{"status":"ok","times