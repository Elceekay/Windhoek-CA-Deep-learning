m() > 0:\n","        lab, lab_file = t, f\n","        break\n","if lab is None:\n","    print(\"No filled-in labels file found. Click 'Choose Files' and select Independent2025_labels.xlsx.\")\n","    from google.colab import files as _files\n","    up = _files.upload()\n","    lab_file = \"/content/\" + list(up.keys())[0]\n","    lab = pd.read_excel(lab_file) if lab_file.lower().endswith(\".xlsx\") else pd.read_csv(lab_file)\n","print(\"Labels file used:\", lab_file)\n","\n","# --- KEY file (map class of each point): search all of My Drive; if absent, read it from the final map\n","keys = glob.glob(\"/content/drive/MyDrive/**/Independent2025_KEY*.csv\", recursive=True)\n","print(\"KEY file used:\", sorted(keys, key=os.path.getmtime)[-1] if keys else \"none found -> map class read from the final 2025 map\")\n","if keys:\n","    key = pd.read_csv(sorted(keys, key=os.path.getmtime)[-1])\n","    d = key[[\"id\", \"map\", \"lon\", \"lat\"]].merge(lab[[\"id\", \"ref\", \"unsure\", \"note\"]], on=\"id\", how=\"left\")\n","else:\n","    d = lab[[\"id\", \"lat\", \"lon\", \"ref\", \"unsure\", \"note\"]].copy()\n","\n","missing = d.loc[d[\"ref\"].isna(), \"id\"].tolist()\n","if missing:\n","    print(\"⚠️ Please label these points first (ref 1–4), save, and run this cell again:\", missing)\n","else:\n","    d[\"ref\"] = d[\"ref\"].astype(int)\n","    # values of the final, automated and raw 2025 maps at each point\n","    pts = gpd.GeoSeries(gpd.points_from_xy(d[\"lon\"], d[\"lat\"]), crs=4326)\n","    areas = {}\n","    for name, f in ((\"final\", ra.PAPER[2025]), (\"automated\", \"Windhoek_LULC_2025_automated.tif\"), (\"raw\", ra.RAW[2025])):\n","        with rasterio.open(D + f) as src:\n","            L = src.read(1); xy = pts.to_crs(src.crs)\n","            r, c = rowcol(src.transform, xy.x.values, xy.y.values)\n","            d[name] = L[np.asarray(r), np.asarray(c)]\n","            areas[name] = ra.class_areas(L)\n","    if keys:\n","        d[\"map\"] = d[\"map\"].astype(int)\n","        print(\"Check (should be 100%): KEY map class = final map at the points:\",\n","              round(100 * (d[\"final\"] == d[\"map\"]).mean(), 1), \"%\")\n","    else:\n","        d[\"map\"] = d[\"final\"].astype(int)\n","    print(\"Points per map class:\", d[\"map\"].value_counts().sort_index().to_dict(), \"(should be 1:100, 2:100, 3:75, 4:25)\")\n","\n","    # 1. Olofsson et al. (2014) estimates for the FINAL map (strata = final map classes)\n","    A = areas[\"final\"]\n","    cm = np.zeros((4, 4), int)\n","    for a, b in zip(d[\"map\"], d[\"ref\"]):\n","        cm[a - 1, b - 1] += 1\n","    res, oa = ra.olofsson_estimator(cm, A)\n","    print(\"\\nError matrix, final 2025 map (rows = map, columns = reference):\")\n","    print(pd.DataFrame(cm, index=ra.NAMES, columns=ra.NAMES))\n","    print(\"\\nError-adjusted areas and accuracies (95% CI half-widths):\"); print(res); print(oa)\n","\n","    # 2. How do the final, automated and raw maps compare? (same strata weights; Stehman 2014)\n","    W = np.array(A) / sum(A)\n","    def est(ind):                       # area-weighted proportion of an indicator over the sample\n","        g = d.assign(v=ind.astype(float)).groupby(\"map\")[\"v\"].mean()\n","        return float(sum(W[h - 1] * g[h] for h in g.index))\n","    true_urban = est(d[\"ref\"] == 1) * sum(A)\n","    comp = []\n","    for name in (\"final\", \"automated\", \"raw\"):\n","        m = d[name]\n","        p11, pm1, pr1 = est((m == 1) & (d[\"ref\"] == 1)), est(m == 1), est(d[\"ref\"] == 1)\n","        comp.append({\"map\": name, \"mapped_urban_km2\": areas[name][0], \"OA_%\": round(100 * est(m == d[\"ref\"]), 1),\n","                     \"urban_UA_%\": round(100 * p11 / pm1, 1) if pm1 else None,\n","                     \"urban_PA_%\": round(100 * p11 / pr1, 1) if pr1 else None})\n","    comp = pd.DataFrame(comp)\n","    print(f\"\\nEstimated TRUE urban area in 2025: {true_urban:.2f} km² \"\n","          f\"(95% CI ± {res.loc['Urban', 'area_ci95_km2']:.2f})\")\n","    print(comp.to_string(index=False))\n","\n","    # 3. Points the final map calls Urban but you labelled otherwise (and vice versa)\n","    errs = d[((d[\"map\"] == 1) & (d[\"ref\"] != 1)) | ((d[\"map\"] != 1) & (d[\"ref\"] == 1))]\n","    print(f\"\\nUrban disagreements: {len(errs)} points\")\n","    print(errs[[\"id\", \"lat\", \"lon\", \"map\", \"ref\", \"automated\", \"raw\", \"unsure\", \"note\"]].to_string(index=False))\n","\n","    res.to_csv(RES + \"TableS8_independent_2025.csv\")\n","    pd.DataFrame(cm, index=ra.NAMES, columns=ra.NAMES).to_csv(RES + \"Independent2025_error_matrix.csv\")\n","    comp.to_csv(RES + \"Independent2025_map_comparison.csv\", index=False)\n","    errs.to_csv(RES + \"Independent2025_urban_disagreements.csv\", index=False)\n","    print(\"\\nSaved to RESULTS ✅\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":16,"status":"ok","timestamp":1792849588687,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"},"user_tz":-120},"id":"_pRjr06lw0fF","outputId":"404286e4-55dc-41ae-d3b1-f5bb812f2723"},"outputs":[{"output_type":"stream","name":"stdout","text":["saved to Drive: /content/drive/MyDrive/GEE_Windhoek/revision_analyses.py\n","saved to Drive: /content/drive/MyDrive/GEE_Windhoek/make_figures.py\n","done ✅\n"]}],"source":["# Cell S  Save the analysis code to Drive (one time) so that after any restart you only need Cells 1, 4 and C0\n","import shutil\n","ok = True\n","for f in (\"revision_analyses.py\", \"make_figures.py\"):\n","    if os.path.exists(\"/content/\" + f):\n","        shutil.copy(\"/content/\" + f, D + f); print(\"saved to Drive:\", D + f)\n","    else:\n","        ok = False; print(\"missing /content/\" + f, \"-> run Cell 2 and Cell 3 first, then this cell again\")\n","print(\"done ✅\" if ok else \"\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://lo