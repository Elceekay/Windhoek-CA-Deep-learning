ib, numpy as np, pandas as pd\n","import revision_analyses as ra, make_figures as mf\n","importlib.reload(ra); importlib.reload(mf)\n","OUT = D + \"revision_runs/\"; os.makedirs(OUT, exist_ok=True)\n","RES = OUT + \"RESULTS/\"; os.makedirs(RES, exist_ok=True)\n","S = ra.Study(D=D)          # should print: Modelling mask: 533.63 km²\n","YEARS = [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025]"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1022,"status":"ok","timestamp":1792364807697,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"},"user_tz":-120},"id":"P2tHeqmeRHUu","outputId":"032b7819-c5ff-4128-88d3-9b47d276152b"},"outputs":[{"name":"stdout","output_type":"stream","text":["update applied ✅\n"]}],"source":["# Cell 4d  Update: read the new shapefiles (true label = 'ref'), count duplicate spots once,\n","#          and read the published (before-correction) matrices from the CSVs\n","import json\n","import geopandas as gpd\n","from shapely.geometry import shape\n","\n","def _find(cols, *cands):\n","    low = {str(c).lower(): c for c in cols}\n","    for c in cands:\n","        if c in low:\n","            return low[c]\n","    return None\n","\n","def read_points(D, year, ref_col=None):\n","    shp, csv = f\"{D}ValidationPoints_{year}.shp\", f\"{D}ValidationPoints_{year}.csv\"\n","    g, src = None, None\n","    if os.path.exists(shp):\n","        g = gpd.read_file(shp)\n","        if g.crs is None:\n","            g = g.set_crs(4326)\n","        g = g[g.geometry.notna() & ~g.geometry.is_empty]\n","        src = \"shp\"\n","        if len(g) == 0:\n","            g = None\n","    if g is None and os.path.exists(csv):\n","        df = pd.read_csv(csv)\n","        geom = [shape(json.loads(t)) if isinstance(t, str) else None for t in df[\".geo\"]]\n","        g = gpd.GeoDataFrame(df, geometry=geom, crs=4326)\n","        g = g[g.geometry.notna() & ~g.geometry.is_empty]\n","        src = \"csv\"\n","    if g is None or len(g) == 0:\n","        raise FileNotFoundError(f\"No validation points with locations for {year} in {D}\")\n","    rc = _find(g.columns, \"ref\", \"landcover\", \"reference\", \"lc\")\n","    g = g.explode(index_parts=False)\n","    xy = g.geometry.apply(lambda p: (round(p.x, 7), round(p.y, 7)))\n","    dup = xy.duplicated().values\n","    g = g[~dup]\n","    g.attrs[\"source\"], g.attrs[\"duplicates_removed\"] = src, int(dup.sum())\n","    return g, rc\n","\n","def csv_matrix(D, year):\n","    \"\"\"Published (before-correction) error matrix: 'ref' = true label, 'landcover' = GEE classification.\"\"\"\n","    f = f\"{D}ValidationPoints_{year}.csv\"\n","    if not os.path.exists(f):\n","        return None\n","    df = pd.read_csv(f)\n","    if not {\"ref\", \"landcover\"} <= set(df.columns):\n","        return None\n","    cm = np.zeros((4, 4), int)\n","    for a, b in zip(df[\"ref\"], df[\"landcover\"]):\n","        if a in (1, 2, 3, 4) and b in (1, 2, 3, 4):\n","            cm[int(a) - 1, int(b) - 1] += 1\n","    return cm\n","\n","ra.read_points = read_points\n","ra.csv_matrix = csv_matrix\n","print(\"update applied ✅\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":7654,"status":"ok","timestamp":1792364841507,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"},"user_tz":-120},"id":"X-KXiCjqRJ33","outputId":"d34dd570-362d-4ec2-ede3-ed3ec969aa96"},"outputs":[{"name":"stdout","output_type":"stream","text":["1990: read from shp  points=199  duplicates removed=1  labels={1: 49, 2: 50, 3: 50, 4: 50}\n","1995: read from shp  points=195  duplicates removed=5  labels={1: 49, 2: 50, 3: 47, 4: 49}\n","2000: read from shp  points=197  duplicates removed=3  labels={1: 50, 2: 48, 3: 50, 4: 49}\n","2005: read from shp  points=199  duplicates removed=1  labels={1: 49, 2: 50, 3: 50, 4: 50}\n","2010: read from shp  points