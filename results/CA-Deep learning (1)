else None for t in df[\".geo\"]]\n","            crs = 4326\n","        else:\n","            xc = _find(df.columns, \"longitude\", \"lon\", \"long\", \"lng\", \"x\", \"easting\")\n","            yc = _find(df.columns, \"latitude\", \"lat\", \"y\", \"northing\")\n","            if xc is None or yc is None:\n","                raise ValueError(f\"{year}: no coordinates found in CSV columns {list(df.columns)}\")\n","            geom = [Point(a, b) for a, b in zip(df[xc], df[yc])]\n","            crs = 32733 if df[xc].abs().max() > 1000 else 4326\n","        g = gpd.GeoDataFrame(df, geometry=geom, crs=crs)\n","        g = g[g.geometry.notna()]\n","        src = \"csv\"\n","    if g is None:\n","        raise FileNotFoundError(f\"No usable ValidationPoints_{year}.shp or .csv in {D}\")\n","    rc = ref_col if ref_col in g.columns else _find(g.columns, \"landcover\", \"reference\", \"ref\", \"lc\", \"class_ref\")\n","    if rc is None:\n","        raise ValueError(f\"{year}: no reference-class column in {list(g.columns)}\")\n","    g = g.explode(index_parts=False)\n","    g.attrs[\"source\"] = src\n","    return g, rc\n","\n","def csv_matrix(D, year, ref_col=\"landcover\"):\n","    f = f\"{D}ValidationPoints_{year}.csv\"\n","    if not os.path.exists(f):\n","        return None\n","    df = pd.read_csv(f)\n","    rc = ref_col if ref_col in df.columns else _find(df.columns, \"landcover\", \"reference\", \"ref\", \"lc\")\n","    mc = _find(df.columns, \"classification\", \"classified\", \"predicted\", \"prediction\", \"map\")\n","    if rc is None or mc is None:\n","        return None\n","    cm = np.zeros((4, 4), int)\n","    for a, b in zip(df[rc], df[mc]):\n","        if a in (1, 2, 3, 4) and b in (1, 2, 3, 4):\n","            cm[int(a) - 1, int(b) - 1] += 1\n","    return cm\n","\n","ra.read_points = read_points\n","ra.csv_matrix = csv_matrix\n","for y in YEARS:\n","    g, rc = ra.read_points(D, y)\n","    vals = pd.Series(g[rc]).value_counts().sort_index().to_dict()\n