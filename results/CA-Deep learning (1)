          \"points_used\": int(CM_FINAL[y].sum()), \"points_outside_or_nodata\": bad})\n","    pd.DataFrame(CM_FINAL[y], index=ra.NAMES, columns=ra.NAMES).to_csv(RES + f\"errmatrix_final_{y}.csv\")\n","    pd.DataFrame(CM_RAW[y], index=ra.NAMES, columns=ra.NAMES).to_csv(RES + f\"errmatrix_raw_{y}.csv\")\n","cmp_ = pd.DataFrame(rows); cmp_.to_csv(RES + \"Step1_accuracy_raw_vs_final.csv\", index=False)\n","print(cmp_.to_string(index=False))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":753,"status":"ok","timestamp":1792167395853,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"},"user_tz":-120},"id":"SGf-uK4qgC27","outputId":"9def1f33-8953-406d-a877-bc0fb88f0e06"},"outputs":[{"name":"stdout","output_type":"stream","text":["1990 {'MultiPoint': 200} | rows: 200\n","1995 {'MultiPoint': 200} | rows: 200\n","2000 {'MultiPoint': 200} | rows: 200\n","2005 {'MultiPoint': 200} | rows: 200\n","2010 {'MultiPoint': 200} | rows: 200\n","2015 {'MultiPoint': 200} | rows: 200\n","2020 {'Point': 200} | rows: 200\n","2025 {'Point': 200} | rows: 200\n","fix applied ✅\n"]}],"source":["# Cell 4b  FIX: handle validation points stored as MultiPoint (run after Cell 4, before Cell 5)\n","import geopandas as gpd, rasterio\n","from rasterio.transform import rowcol\n","\n","for y in YEARS:   # shows what each file contains\n","    g, _ = ra.read_points(D, y)\n","    print(y, g.geom_type.value_counts().to_dict(), \"| rows:\", len(g))\n","\n","def points_matrix(D, year, raster_path, ref_col=\"landcover\"):\n","    g, ref_col = ra.read_points(D, year, ref_col)\n","    g = g[g.geometry.notna() & ~g.geometry.is_empty]\n","    g = g.explode(index_parts=False)                     # MultiPoint -> one row per point\n","    with rasterio.open(raster_path) as src:\n","        L = src.read(1); g = g.to_crs(src.crs)\n","        pts = g.geometry if (g.geom_type == \"Point\").all() else g.geometry.representative_point()\n","        r, c = rowcol(src.transform, pts.x.values, pts.y.values)\n","    r, c = np.asarray(r), np.asarray(c)\n","    ok = (r >= 0) & (r < L.shape[0]) & (c >= 0) & (c < L.shape[1])\n","    ref = g[ref_col].values.astype(int)[ok]\n","    mp = L[r[ok], c[ok]].astype(int)\n","    keep = np.isin(ref, [1, 2, 3, 4]) & np.isin(mp, [1, 2, 3, 4])\n","    cm = np.zeros((4, 4), int)\n","    np.add.at(cm, (ref[keep] - 1, mp[keep] - 1), 1)\n","    return cm, int((~ok).sum() + (~keep).sum())\n","\n","ra.points_matrix = points_matrix\n","print(\"fix applied ✅\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1865,"status":"ok","timestamp":1792167469659,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"},"user_tz":-120},"id":"06k3Sh7pgUr8","outputId":"978ed426-a780-41e7-b183-135a5af53bb1"},"outputs":[{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_1053/152510756.py:11: UserWarning: GeoSeries.notna() previously returned False for both missing (None) and empty geometries. Now, it only returns False for missing values. Since the calling GeoSeries contains empty geometries, the result has changed compared to previous versions of GeoPandas.\n","Given a GeoSeries 's', you can use '~s.is_empty & s.notna()' to get back the old behaviour.\n","\n","To further ignore this warning, you can do: \n","import warnings; warnings.filterwarnings('ignore', 'GeoSeries.notna', UserWarning)\n","  g = g[g.geometry.notna() & ~g.geometry.is_empty]\n","/tmp/ipykernel_1053/152510756.py:11: UserWarning: GeoSeries.notna() previously returned False for both missing (None) and empty geometries. Now, it only returns False for missing values. Since the calling GeoSeries contains empty geometries, the result has changed compared to previous versions of GeoPandas.\n","Given a GeoSeries 's', you can use '~s.is_empty & s.notna()' to get back the old behaviour.\n","\n","To further ign