plt.subplots(3, 3, figsize=(W, W * 1.02))\n","cmap = ListedColormap(mf.LULC_COLS)\n","for k, ax in enumerate(axes.flat):\n","    if k == 8:\n","        ax.axis(\"off\")\n","        ax.legend(handles=[Patch(color=c, label=n) for c, n in zip(mf.LULC_COLS, mf.LULC_NAMES)], loc=\"upper left\",\n","                  bbox_to_anchor=(0.02, 1.0), frameon=False, fontsize=8, title=\"Land use/land cover\", title_fontsize=8.5,\n","                  alignment=\"left\")\n","        ax.text(0.04, 0.05, \"WGS 84 / UTM zone 33S;\\ncoordinates in km\", transform=ax.transAxes, fontsize=7, va=\"bottom\")\n","        continue\n","    y = YEARS[k]\n","    ax.imshow(mf._lulc_img(S, S.P[y], crop), cmap=cmap, vmin=0.5, vmax=4.5, extent=ext, interpolation=\"nearest\")\n","    mf._style_axes(ax, ext, left=(k % 3 == 0), bottom=(k >= 5))\n","    ax.tick_params(labelsize=6.5)\n","    ax.set_title(f\"({'abcdefgh'[k]}) {y}\", fontsize=8.5, loc=\"left\", pad=2)\n","    for i, (n, x, yy) in enumerate(PLACES):\n","        ax.plot(x, yy, \"o\", ms=7, mfc=\"white\", mec=\"black\", mew=0.6, zorder=5, clip_on=True)\n","        ax.text(x, yy, str(i + 1), fontsize=5.5, fontweight=\"bold\", ha=\"center\", va=\"center\", zorder=6, clip_on=True)\n","    if k == 7:\n","        mf._scalebar(ax, ext)\n","fig.legend(handles=[Line2D([], [], marker=\"o\", ms=6.5, mfc=\"white\", mec=\"black\", ls=\"\", label=f\"{i + 1}  {n}\")\n","                    for i, (n, _, _) in enumerate(PLACES)], loc=\"lower center\", ncol=3, bbox_to_anchor=(0.5, 0.0),\n","           frameon=False, fontsize=8, title=\"Places\", title_fontsize=8.5, handletextpad=0.3, columnspacing=2.0)\n","fig.subplots_adjust(wspace=0.06, hspace=0.16, bottom=0.11)\n","mf._save(fig, mf._out(S, \"Figure3_LULC_1990_2025_v2\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fld9CJmQdITq","executionInfo":{"status":"ok","timestamp":1793726940477,"user_tz":-120,"elapsed":9433,"user":{"displayName":"Elaine Ceekay","userId":"14836129535704673619"